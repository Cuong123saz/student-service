{
  "name": "@student-service/api",
  "version": "1.0.0",
  "private": true,
  "description": "Student service API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-document-supervisor.mjs",
    "start": "node dist/server.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.test.config.ts",
    "auth:bootstrap-admin": "tsx src/modules/auth/bootstrap-system-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "mail:smoke": "tsx src/scripts/send-test-invitation-email.ts",
    "invitations:worker": "tsx src/scripts/run-invitation-worker.ts",
    "invitations:worker:once": "tsx src/scripts/run-invitation-worker.ts --once",
    "imports:worker": "tsx src/scripts/run-student-import-worker.ts",
    "imports:worker:once": "tsx src/scripts/run-student-import-worker.ts --once",
    "auth:recover-admin": "tsx src/modules/auth/recover-system-admin-password.ts",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "npm run db:migrate:test && node scripts/run-tests.mjs integration",
    "test": "npm run test:unit && npm run test:integration && npm run test:storage && npm run test:recovery && npm run test:bundle",
    "test:concurrency": "node --test scripts/check-concurrency.test.mjs && npm run build && node --env-file=.env.test scripts/check-concurrency.mjs",
    "test:search-profile": "node --test scripts/check-concurrency.test.mjs && npm run build && node --env-file=.env.test scripts/check-concurrency.mjs --profile-search",
    "audit:storage": "node --env-file=.env scripts/audit-evidence.mjs",
    "test:storage": "node --test scripts/evidence-integrity.test.mjs && node --env-file=.env.test --test scripts/evidence-integrity.sql.test.mjs",
    "test:recovery": "npm run test:fixtures && node --test scripts/recovery-assets.test.mjs scripts/document-registry-inventory.test.mjs scripts/recovery-bundle.test.mjs scripts/recovery-archive.test.mjs scripts/encrypted-recovery.test.mjs scripts/encrypted-recovery-archive.test.mjs && npm run test:workflow-demo && npm run test:offline-development",
    "recovery:encrypted": "node scripts/manage-encrypted-recovery.mjs --fake-data-only",
    "recovery:archive": "node scripts/manage-recovery-archive.mjs --fake-data-only",
    "rehearse:recovery": "npm run test:recovery && npm run build && node scripts/rehearse-recovery.mjs --fake-data-only",
    "test:fixtures": "node --import tsx --test scripts/recovery-fixture.test.mjs",
    "demo:workflow": "node scripts/workflow-demo.mjs --fake-data-only",
    "demo:workflow:check": "node scripts/check-workflow-demo.mjs --fake-data-only",
    "test:workflow-demo": "node --test scripts/workflow-demo.contract.test.mjs scripts/workflow-vault.contract.test.mjs",
    "demo:documents": "node scripts/workflow-demo.mjs --fake-data-only --documents",
    "demo:documents:check": "node scripts/check-workflow-demo.mjs --fake-data-only --documents",
    "bundle:verify": "node scripts/verify-submission-bundle.mjs",
    "test:bundle": "node --import tsx --test scripts/verify-submission-bundle.test.mjs",
    "demo:bundles": "node scripts/workflow-demo.mjs --fake-data-only --bundles",
    "demo:bundles:check": "node scripts/check-workflow-demo.mjs --fake-data-only --bundles",
    "documents:check": "node --env-file-if-exists=.env scripts/check-document-runtime.mjs",
    "rehearse:document-recovery": "npm run test:recovery && npm run build && node scripts/rehearse-recovery.mjs --fake-data-only --document-assets",
    "rehearse:registry-recovery": "npm run test:recovery && npm run build && node scripts/rehearse-recovery.mjs --fake-data-only --document-registry",
    "audit:documents": "node --env-file=.env scripts/audit-documents.mjs",
    "demo:vault": "node scripts/workflow-demo.mjs --fake-data-only --vault",
    "demo:vault:check": "node scripts/check-workflow-demo.mjs --fake-data-only --vault",
    "documents:process-check": "node scripts/check-document-supervisor.mjs --fake-data-only",
    "rehearse:retry-browser": "node scripts/workflow-demo.mjs --fake-data-only --retry",
    "development:preserve-offline": "node scripts/preserve-offline-development.mjs --offline-development-only",
    "test:offline-development": "node --test scripts/offline-development.contract.test.mjs scripts/development-upgrade.contract.test.mjs",
    "development:verify-upgrade": "node scripts/preserve-offline-development.mjs --offline-development-only --verify-upgrade",
    "demo:workspace-vault": "node scripts/workflow-demo.mjs --fake-data-only --workspace-vault",
    "demo:workspace-vault:check": "node scripts/check-workflow-demo.mjs --fake-data-only --workspace-vault",
    "development:audit-upgrade": "node scripts/audit-development-upgrade.mjs --offline-development-only",
    "rehearse:sprint4": "node scripts/workflow-demo.mjs --fake-data-only --sprint4"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fflate": "^0.8.3",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.9",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
