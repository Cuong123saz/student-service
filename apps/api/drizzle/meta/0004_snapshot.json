        "user_action_tokens_purpose_check": {
          "name": "user_action_tokens_purpose_check",
          "value": "\n          \"user_action_tokens\".\"purpose\" IN (\n            'ACCOUNT_ACTIVATION',\n            'PASSWORD_RESET'\n          )\n        "
        },
        "user_action_tokens_expiration_policy_check": {
          "name": "user_action_tokens_expiration_policy_check",
          "value": "\n    \"user_action_tokens\".\"expires_at\"\n      > \"user_action_tokens\".\"created_at\"\n\n    AND (\n      \"user_action_tokens\".\"purpose\"\n        <> 'ACCOUNT_ACTIVATION'\n      OR\n      \"user_action_tokens\".\"expires_at\"\n        <= \"user_action_tokens\".\"created_at\"\n          + INTERVAL '72 hours'\n    )\n\n    AND (\n      \"user_action_tokens\".\"purpose\"\n        <> 'PASSWORD_RESET'\n      OR\n      \"user_action_tokens\".\"expires_at\"\n        <= \"user_action_tokens\".\"created_at\"\n          + INTERVAL '30 minutes'\n    )\n  "
        },
        "user_action_tokens_terminal_state_check": {
          "name": "user_action_tokens_terminal_state_check",
          "value": "\n          NOT (\n            \"user_action_tokens\".\"consumed_at\" IS NOT NULL\n            AND \"user_action_tokens\".\"revoked_at\" IS NOT NULL\n          )\n        "
        }
