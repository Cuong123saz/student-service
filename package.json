{
  "name": "student-service",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web,imports --prefix-colors blue,green,magenta \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:imports-worker\"",
    "dev:api": "npm run dev --workspace @student-service/api",
    "dev:web": "npm run dev --workspace @student-service/web",
    "dev:imports-worker": "npm run imports:worker --workspace @student-service/api",
    "check": "npm run check:api",
    "check:api": "npm run typecheck --workspace @student-service/api",
    "check:sprint4-adr": "node scripts/check-sprint4-adr-gate.mjs",
    "lint": "npm run lint --workspace @student-service/api",
    "format": "prettier --write \"apps/api/src/**/*.ts\" \"apps/api/*.ts\" \"apps/web/app/**/*.{ts,vue}\" \"apps/web/test/**/*.ts\" \"apps/web/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"apps/api/src/**/*.ts\" \"apps/api/*.ts\" \"apps/web/app/**/*.{ts,vue}\" \"apps/web/test/**/*.ts\" \"apps/web/*.ts\" \"*.json\"",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace @student-service/api",
    "test:web": "npm run test --workspace @student-service/web && npm run test:acceptance --workspace @student-service/web",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace @student-service/api",
    "build:web": "npm run build --workspace @student-service/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  }
}
